[72.639166, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 2  | Анна, Мария |  23 |   False   |\r\n+----+-------------+-----+-----------+\r\nНайдено записей: 1.\r\nВведите команду: "]
[77.089981, "o", "info demo_crud"]
[77.895168, "o", "\r\n"]
[77.896127, "o", "Таблица: demo_crud\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\nВведите команду: "]
