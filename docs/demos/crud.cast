[41.608539, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[41.608739, "o", "\r\nНайдено записей: 1.\r\nВведите команду: "]
