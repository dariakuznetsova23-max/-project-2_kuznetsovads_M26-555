{"version": 2, "width": 120, "height": 30, "timestamp": 1793547763, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.041744, "o", "\r\nДобро пожаловать в Primitive DB!\r\n\r\n***База данных***\r\n\r\nУправление таблицами:\r\ncreate_table <таблица> <столбец:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <таблица> - удалить таблицу\r\ninfo <таблица> - информация о таблице\r\n\r\nОперации с данными:\r\ninsert into <таблица> values (<значение>, ...) - добавить запись\r\nselect from <таблица> - показать все записи\r\nselect from <таблица> where <столбец> = <значение>\r\nupdate <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <таблица> where <столбец> = <значение>\r\n\r\nОбщие команды:\r\nhelp - справочная информация\r\nexit - выход из программы\r\n\r\nТипы: int, str, bool.\r\nСтроки — в кавычках. Булевы значения — true или false.\r\nID создаётся автоматически и не передаётся в insert.\r\n\r\n"]
[0.042986, "o", "Введите команду: "]
[6.905822, "o", "create_table demo_crud name:str age:int is_active:bool"]
[8.056553, "o", "\r\n"]
[8.058768, "o", "Таблица \"demo_crud\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\nВведите команду: "]
[13.100582, "o", "insert into demo_crud values (\"Sergei\", 28, true)"]
[13.923729, "o", "\r\n"]
[13.924533, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[13.925081, "o", "Запись с ID=1 успешно добавлена в таблицу \"demo_crud\".\r\nВведите команду: "]
[18.970809, "o", "insert into demo_crud values (\"Анна, Мария\", 23, false)"]
[19.769361, "o", "\r\n"]
[19.770407, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[19.771196, "o", "Запись с ID=2 успешно добавлена в таблицу \"demo_crud\".\r\nВведите команду: "]
[24.578235, "o", "select from demo_crud"]
[25.422876, "o", "\r\n"]
[25.423877, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[25.447329, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 1  |    Sergei   |  28 |    True   |\r\n| 2  | Анна, Мария |  23 |   False   |\r\n+----+-------------+-----+-----------+\r\nНайдено записей: 2.\r\nВведите команду: "]
[34.229014, "o", "select from demo_crud"]
[35.15775, "o", "\r\n"]
[35.158674, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[35.159299, "o", "+----+-------------+-----+-----------+\r\n| ID |     name    | age | is_active |\r\n+----+-------------+-----+-----------+\r\n| 1  |    Sergei   |  28 |    True   |\r\n| 2  | Анна, Мария |  23 |   False   |\r\n+----+-------------+-----+-----------+\r\nНайдено записей: 2.\r\n"]
[35.159655, "o", "Введите команду: "]
