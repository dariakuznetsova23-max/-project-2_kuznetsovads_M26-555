[40.868107, "o", "\u001b[?2004h\u001b]0;daria@LAPTOP-8941CFRI: ~/projects/primitive-db\u0007\u001b[01;32mdaria@LAPTOP-8941CFRI\u001b[00m:\u001b[01;34m~/projects/primitive-db\u001b[00m$ "]
[45.013765, "o", "database"]
[45.851386, "o", "\r\n\u001b[?2004l\r"]
[45.911836, "o", "\r\nДобро пожаловать в Primitive DB!\r\n\r\n***База данных***\r\n\r\nУправление таблицами:\r\ncreate_table <таблица> <столбец:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <таблица> - удалить таблицу\r\ninfo <таблица> - информация о таблице\r\n\r\nОперации с данными:\r\ninsert into <таблица> values (<значение>, ...) - добавить запись\r\nselect from <таблица> - показать все записи\r\nselect from <таблица> where <столбец> = <значение>\r\nupdate <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <таблица> where <столбец> = <значение>\r\n\r\nОбщие команды:\r\nhelp - справочная информация\r\nexit - выход из программы\r\n\r\nТипы: int, str, bool.\r\nСтроки — в кавычках. Булевы значения — true или false.\r\nID создаётся автоматически и не передаётся в insert.\r\n\r\nВведите команду: "]
[53.618837, "o", "create_table demo_tables name:str age:int is_active:bool"]
[54.478265, "o", "\r\n"]
[54.479617, "o", "Таблица \"demo_tables\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\nВведите команду: "]
[59.536616, "o", "list_tables"]
[60.402795, "o", "\r\n"]
[60.403451, "o", "- demo_tables\r\nВведите команду: "]
[65.218153, "o", "info demo_tables"]
[66.042238, "o", "\r\n"]
[66.043173, "o", "Таблица: demo_tables\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\nВведите команду: "]
[71.414806, "o", "drop_table demo_tables"]
[72.267459, "o", "\r\n"]
[72.268133, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[76.608842, "o", "y"]
[77.478929, "o", "\r\n"]
[77.481659, "o", "Таблица \"demo_tables\" успешно удалена.\r\nВведите команду: "]
[83.765411, "o", "list_tables"]
[84.673839, "o", "\r\n"]
[84.674163, "o", "Таблиц пока нет.\r\nВведите команду: "]
[88.866061, "o", "exit"]
[89.727184, "o", "\r\n"]
[89.727435, "o", "До свидания!\r\n"]
